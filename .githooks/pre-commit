#!/bin/sh
# Quality gate (install once: `git config core.hooksPath .githooks`).
#   ruff   -> general lint + line length            (tracks + tests)
#   flake8 -> cognitive complexity, CCR001          (tracks; tests are linear
#              journey scripts and are exempt from complexity gating)
#   pylint -> duplication R0801 + file length C0302 (tracks + tests, cross-detected)
#           -> method length R0915 / locals R0914   (tracks only; test exempt)
# Thresholds live in pyproject [tool.pylint.*] and .flake8.
set -e
ROOT="$(git rev-parse --show-toplevel)"
BIN="$ROOT/.venv/bin"
if [ ! -x "$BIN/python" ]; then
    echo "[pre-commit] .venv missing; run: python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
    exit 1
fi
cd "$ROOT"
echo "[pre-commit] ruff"
"$BIN/ruff" check tracks tests
echo "[pre-commit] cognitive complexity (tracks)"
"$BIN/flake8" tracks
echo "[pre-commit] pylint: duplication + file length (tracks + tests)"
"$BIN/pylint" --disable=all --enable=R0801,C0302 tracks tests
echo "[pre-commit] pylint: method length + locals (tracks)"
"$BIN/pylint" --disable=all --enable=R0915,R0914 tracks
echo "[pre-commit] OK"
