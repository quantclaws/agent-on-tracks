+def _run_had_gate_event(db: ServiceDB, run_id: str) -> bool:
+    """True once any human gate command was accepted for the run
+    (counterexample AC-FR0345-01: the post-gate drive half reads this flag —
+    after a gate command executes the supervisor parks the run)."""
+    with contextlib.closing(_connect_store(db.home, readonly=True)) as conn:
+        rows = conn.execute(
+            "SELECT 1 FROM commands WHERE run_id = ? AND kind IN "
+            "('record_triage', 'record_review', 'record_stage_approval',"
+            " 'record_release_decision') AND status IN ('accepted', 'completed')"
+            " LIMIT 1",
+            (run_id,),
+        ).fetchall()
+    return bool(rows)
+
