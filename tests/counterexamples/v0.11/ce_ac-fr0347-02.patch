+def _any_non_self_pending_threads(doc_paths: list[Path], reviewer: str) -> bool:
+    """Whether any unresolved thread was initiated by anyone but ``reviewer``
+    (counterexample AC-FR0347-02: the pre-v0.11 form — any non-self thread
+    flips a pass to revise again)."""
+    own_key = speaker_key(reviewer)
+    for path in doc_paths:
+        if not path.exists():
+            continue
+        text = path.read_text(encoding="utf-8")
+        for thread in parse_threads(text):
+            if thread.status == "resolved":
+                continue
+            if speaker_key(thread.initiator) != own_key:
+                return True
+    return False
+
