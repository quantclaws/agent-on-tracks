{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/tracks/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/tracks/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "{env:TMPDIR}tracks/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private{env:TMPDIR}tracks/*",
      "effect": "allow"
    }
  ],
  "compaction": {
    "auto": true
  }
}
