{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "{env:TMPDIR}tracks/**": "allow",
      "/private{env:TMPDIR}tracks/**": "allow"
    }
  },
  "agent": {
    "Scribe": {
      "permission": {
        "external_directory": {
          "*": "deny",
          "{env:TMPDIR}tracks/**": "allow",
          "/private{env:TMPDIR}tracks/**": "allow"
        }
      }
    },
    "Sage": {
      "permission": {
        "external_directory": {
          "*": "deny",
          "{env:TMPDIR}tracks/**": "allow",
          "/private{env:TMPDIR}tracks/**": "allow"
        }
      }
    },
    "Lex": {
      "permission": {
        "external_directory": {
          "*": "deny",
          "{env:TMPDIR}tracks/**": "allow",
          "/private{env:TMPDIR}tracks/**": "allow"
        }
      }
    }
  }
}
