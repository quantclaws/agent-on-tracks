{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "allow",
      "{env:TMPDIR}**": "allow",
      "/private{env:TMPDIR}**": "allow"
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "litellm (self-dev)",
      "options": {
        "baseURL": "http://192.168.0.102:4001/v1",
        "apiKey": "{env:TRAC_LIVE_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        }
      }
    }
  },
  "agent": {
    "Scribe": {
      "permission": {
        "external_directory": {
          "*": "deny",
          "{env:TMPDIR}**": "allow",
          "/private{env:TMPDIR}**": "allow"
        }
      }
    },
    "Sage": {
      "permission": {
        "external_directory": {
          "*": "deny",
          "{env:TMPDIR}**": "allow",
          "/private{env:TMPDIR}**": "allow"
        }
      }
    },
    "Lex": {
      "permission": {
        "external_directory": {
          "*": "deny",
          "{env:TMPDIR}**": "allow",
          "/private{env:TMPDIR}**": "allow"
        }
      }
    }
  }
}
