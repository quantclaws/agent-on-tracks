__pycache__/
*.pyc
*.egg-info/
.venv
.coverage
.coverage.*
.env
/.tracks/runtime/
/.tracks/worktrees/
build/
dist/
.opencode
*.lock

# runtime opencode session logs
logs/

# handoff 是一次性交接文件，用完即删，不入库（2026-08-15 用户裁定）
.tracks/wiki/handoff-*.md
# BEGIN tracks-managed (runtime test-command byproducts)
__pycache__/
*.py[cod]
.pytest_cache/
# END tracks-managed

# runtime state (mutates every serve/poll cycle — never freeze-relevant)
.tracks/service/service.db
.tracks/service/service.db-shm
.tracks/service/service.db-wal
.tracks/projects/*/events.db

# the vendored editor ships its npm dist layout in-tree (the wheel and
# any candidate worktree must serve it)
!tracks/server/static/vendor/vditor/dist/
